# 复制为 .env 后填写自己的模型配置。请勿提交真实 API Key。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=your-model-name

# 以下是公开演示设置，不包含个人服务配置。
AGENT_TOOL_MODE=mcp
AGENT_HISTORY_SEARCH=keywords
AGENT_CONTEXT_TOKENS=32768
AGENT_RECENT_TOKENS=2048
AGENT_SUMMARY_TOKENS=512

# 可选：运行 python local_embeddings.py 下载模型后改用 hybrid。
# 运行中的服务不会主动下载模型；模型不可用时回退关键词检索。
